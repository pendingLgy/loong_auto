{
  "name": "loong",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "shared/client",
      "shared/ui",
      "web"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.0.0",
      "effect": "^3.0.0",
      "eventsource-parser": "^3.0.0",
      "solid-js": "^1.9.0",
      "tailwindcss": "^4.0.0",
      "typescript": "^5.6.0",
      "vite": "^6.0.0",
      "vite-plugin-solid": "^2.11.0",
      "@solid-primitives/i18n": "^3.0.0",
      "@solidjs/router": "^0.15.0",
      "@tanstack/solid-virtual": "^3.13.0"
    }
  },
  "scripts": {
    "dev:web": "bun run --filter '@loong/web' dev",
    "build:web": "bun run --filter '@loong/web' build",
    "typecheck": "bun run --filter '@loong/web' typecheck && bun run --filter '@loong/ui' typecheck"
  }
}
