      "@tanstack/solid-virtual": "^3.13.53",
      "@astrojs/markdown-remark": "^7.3.10",
      "@solid-primitives/event-listener": "^2.4.0"
    }
  },
  "scripts": {
    "dev:web": "bun run --filter '@loong/web' dev",
