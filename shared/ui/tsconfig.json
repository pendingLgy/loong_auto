{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/login/**/*.ts", "src/login/**/*.tsx", "src/server-config/**/*.ts", "src/server-config/**/*.tsx", "src/layout/**/*.ts", "src/layout/**/*.tsx", "src/nav/**/*.ts", "src/nav/**/*.tsx", "src/settings/**/*.ts", "src/settings/**/*.tsx"]
}
