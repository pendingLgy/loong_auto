LOCAL_HOST=127.0.0.1
LOCAL_PORT=9528
LOCAL_CLOUD_URL=http://127.0.0.1:9527
LOCAL_WORKSPACE=.
LOCAL_DATA_PATH=local/data/gateway.sqlite3
LOCAL_LOG_PATH=local/logs/gateway.log
LOCAL_TIMEOUT=180
LOCAL_CONNECT_TIMEOUT=10
LOCAL_SSE_READ_TIMEOUT=60
LOCAL_HEARTBEAT_INTERVAL=15
LOCAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 默认放行模式：read_only（仅查看）/ workspace_write（工作区内修改，高危操作需人工确认）/ full（完全权限）
# 客户端可用 X-Workspace-Policy 请求头按连接覆盖；应用通过 LOONG_GATEWAY_CONFIG__ 前缀读取。
LOONG_GATEWAY_CONFIG__WORKSPACE_MODE=read_only
