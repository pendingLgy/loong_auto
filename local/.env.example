# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOONG_LOG_LEVEL=INFO

LOONG_ENABLE_SECURITY_TOKEN=true
LOONG_SECURITY_TOKEN=feEVnpc9LrPfEWjswTzXz3FAaPKLWwZqrp08aLlvF10

# LOONG_GATEWAY_CONFIG__ 环境变量优先于文件；相对日志路径以启动工作目录为基准。
LOONG_GATEWAY_CONFIG__HOST=127.0.0.1
LOONG_GATEWAY_CONFIG__PORT=9528
LOONG_GATEWAY_CONFIG__CLOUD_URL=http://127.0.0.1:9527
LOONG_GATEWAY_CONFIG__TIMEOUT=180
LOONG_GATEWAY_CONFIG__CONNECT_TIMEOUT=10
LOONG_GATEWAY_CONFIG__SSE_READ_TIMEOUT=60
LOONG_GATEWAY_CONFIG__ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
LOONG_GATEWAY_CONFIG__ALLOWED_HOSTS='["127.0.0.1"]'
LOONG_GATEWAY_CONFIG__LOG_PATH=F:/workspace/codepython/loong_auto/local/logs/gateway.log


# SQLite 配置
LOONG_DB_CONFIG__TABLE_PREFIX=local_
# 相对路径以服务进程的工作目录为基准；:memory: 表示内存数据库
LOONG_DB_CONFIG__SQLITE__DATABASE=F:\workspace\code\python\loong_auto\local\loong-local.db
LOONG_DB_CONFIG__SQLITE__PRINT_SQL=true
# SQLite 写锁等待超时时间（秒）
LOONG_DB_CONFIG__SQLITE__TIMEOUT=10.0
# 留空使用驱动默认事务隔离级别
LOONG_DB_CONFIG__SQLITE__ISOLATION_LEVEL=
LOONG_DB_CONFIG__SQLITE__CHECK_SAME_THREAD=false

# 连接池配置；时间单位为秒，RECYCLE=-1 禁用连接回收
# 常驻连接数量
LOONG_DB_CONFIG__POOL__SIZE=5
# 允许的额外连接数量
LOONG_DB_CONFIG__POOL__MAX_OVERFLOW=10
# 等待获取连接的超时时间，与 SQLite 写锁等待时间分别配置
LOONG_DB_CONFIG__POOL__TIMEOUT=30
# 连接回收时间
LOONG_DB_CONFIG__POOL__RECYCLE=1800
# 获取连接前检查连接有效性
LOONG_DB_CONFIG__POOL__PRE_PING=true
