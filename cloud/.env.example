# GlobalConfig 示例：复制为 cloud/.env。
# JWT：启用登录前填写至少 32 字符的随机密钥，不提交真实密钥
# LOONG_TOKEN_CONFIG__SECRET=
LOONG_TOKEN_CONFIG__ISSUER=loong-cloud
LOONG_TOKEN_CONFIG__ACCESS_TTL=3600
LOONG_TOKEN_CONFIG__REFRESH_TTL=604800
# 缓存配置；TTL 在写入时指定，未指定则不过期
LOONG_CACHE_CONFIG__CACHE_TYPE=sqlite
LOONG_CACHE_CONFIG__PREFIX=loong
LOONG_CACHE_CONFIG__SQLITE__DATABASE=loong-cache.db
LOONG_CACHE_CONFIG__SQLITE__TIMEOUT=30
LOONG_CACHE_CONFIG__SQLITE__CLEANUP_INTERVAL=5
# SQLite 缓存仅支持文件模式，以下为缓存连接池配置
LOONG_CACHE_CONFIG__SQLITE__POOL__SIZE=5
LOONG_CACHE_CONFIG__SQLITE__POOL__MAX_OVERFLOW=10
LOONG_CACHE_CONFIG__SQLITE__POOL__TIMEOUT=30
LOONG_CACHE_CONFIG__SQLITE__POOL__RECYCLE=1800
LOONG_CACHE_CONFIG__SQLITE__POOL__PRE_PING=true
# 固定前缀 LOONG_，双下划线 __ 表示嵌套字段；进程环境变量优先。

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOONG_LOG_LEVEL=INFO
# URL 白名单使用 JSON 数组
LOONG_WHITE_LIST_URLS='["/api/status","/api/status/health"]'

# SQLite 配置
LOONG_DB_CONFIG__DB_TYPE=sqlite
LOONG_DB_CONFIG__TABLE_PREFIX=loong_
# 相对路径以服务进程的工作目录为基准；:memory: 表示内存数据库
LOONG_DB_CONFIG__SQLITE__DATABASE=loong-cloud.db
LOONG_DB_CONFIG__SQLITE__PRINT_SQL=false
# SQLite 写锁等待超时时间（秒）
LOONG_DB_CONFIG__SQLITE__TIMEOUT=30.0
# 留空使用驱动默认事务隔离级别
LOONG_DB_CONFIG__SQLITE__ISOLATION_LEVEL=
LOONG_DB_CONFIG__SQLITE__CHECK_SAME_THREAD=false

# 连接池配置；时间单位为秒，RECYCLE=-1 禁用连接回收
# 常驻连接数量
LOONG_DB_CONFIG__POOL__SIZE=5
# 允许的额外连接数量
LOONG_DB_CONFIG__POOL__MAX_OVERFLOW=10
# 等待获取连接的超时时间，与 SQLite 写锁等待时间分别配置
LOONG_DB_CONFIG__POOL__TIMEOUT=30
# 连接回收时间
LOONG_DB_CONFIG__POOL__RECYCLE=1800
# 获取连接前检查连接有效性
LOONG_DB_CONFIG__POOL__PRE_PING=true
